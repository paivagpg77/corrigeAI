generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  PROFESSOR
  COORDENADOR
  DIRETOR
}

enum StatusProva {
  RASCUNHO
  PUBLICADA
  FINALIZADA
}

model Escola {
  id           Int          @id @default(autoincrement())
  nome         String
  cnpj         String?      @unique
  email        String?
  telefone     String?
  endereco     String?
  logo         String?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  usuarios     Usuario[]
  turmas       Turma[]
  disciplinas  Disciplina[]
}

model Usuario {
  id           Int              @id @default(autoincrement())
  nome         String
  email        String           @unique
  senha        String
  tipo         TipoUsuario
  ativo        Boolean          @default(true)

  escolaId     Int?
  escola       Escola?          @relation(fields: [escolaId], references: [id])

  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  provas       Prova[]
  turmas       ProfessorTurma[]
}

model Turma {
  id           Int              @id @default(autoincrement())
  codigo       String
  nome         String
  serie        String?
  turno        String?

  escolaId     Int
  escola       Escola           @relation(fields: [escolaId], references: [id])

  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  alunos       Aluno[]
  professores  ProfessorTurma[]
  provas       Prova[]

  @@unique([escolaId, codigo])
}

model ProfessorTurma {
  id           Int      @id @default(autoincrement())

  professorId  Int
  professor    Usuario  @relation(fields: [professorId], references: [id], onDelete: Cascade)

  turmaId      Int
  turma        Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())

  @@unique([professorId, turmaId])
}

model Aluno {
  id              Int       @id @default(autoincrement())
  matricula       String
  nome            String
  dataNascimento  DateTime?
  responsavel     String?
  emailResponsavel String?

  turmaId         Int
  turma           Turma     @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  @@unique([turmaId, matricula])
}

model Disciplina {
  id           Int       @id @default(autoincrement())
  nome         String

  escolaId     Int?
  escola       Escola?   @relation(fields: [escolaId], references: [id])

  criadoEm     DateTime  @default(now())

  provas       Prova[]

  @@unique([escolaId, nome])
}

model Prova {
  id             Int          @id @default(autoincrement())
  titulo         String
  totalQuestoes  Int
  status         StatusProva  @default(RASCUNHO)
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt

  professorId    Int
  professor      Usuario      @relation(fields: [professorId], references: [id])

  disciplinaId   Int
  disciplina     Disciplina   @relation(fields: [disciplinaId], references: [id])

  turmaId        Int?
  turma          Turma?       @relation(fields: [turmaId], references: [id])

  questoes       Questao[]
}

model Questao {
  id            Int      @id @default(autoincrement())
  numero        Int
  enunciado     String?
  alternativaA  String?
  alternativaB  String?
  alternativaC  String?
  alternativaD  String?
  alternativaE  String?
  resposta      String?

  provaId       Int
  prova         Prova    @relation(fields: [provaId], references: [id], onDelete: Cascade)

  @@unique([provaId, numero])
}